{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/threathunterX/nebula2/packages/domain-schema/strategy.schema.json",
  "title": "Strategy",
  "description": "风控策略。策略由若干条款(term)组成,条款全部满足时触发处置动作。相比 1.x,2.0 支持嵌套布尔组合,并真正落地风险分与自动处置。",
  "type": "object",
  "required": ["app", "name", "visible_name", "status", "category", "condition", "action"],
  "additionalProperties": false,
  "properties": {
    "app": { "type": "string", "const": "nebula" },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_\\u4e00-\\u9fa5-]+$",
      "description": "策略唯一标识。"
    },
    "visible_name": { "type": "string" },
    "remark": { "type": "string", "default": "", "description": "策略含义说明,会展示在告警详情中。" },
    "version": { "type": "string", "default": "2.0" },
    "status": {
      "type": "string",
      "enum": ["inedit", "test", "online", "outline"],
      "description": "只有 online 且处于生效时间窗内的策略参与计算。test 状态产生的告警会标记 test=true,不影响线上决策。"
    },
    "category": {
      "type": "string",
      "enum": ["VISITOR", "ACCOUNT", "TRANSACTION", "ORDER", "MARKETING", "OTHER"],
      "description": "风险场景。"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "风险标签,用于告警聚合与报表下钻。取值参见 seeds/tags.json。"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "description": "策略权重,参与风险分计算。1.x 内置策略此值全为 0(风险分未落地),2.0 要求显式赋值。"
    },
    "effective_from": { "type": ["integer", "null"], "default": null, "description": "生效起始时间(毫秒)。null 表示立即生效。" },
    "effective_to": { "type": ["integer", "null"], "default": null, "description": "生效截止时间(毫秒)。null 表示长期有效。" },

    "trigger": {
      "type": "object",
      "required": ["event"],
      "description": "触发事件。策略在该事件到达时求值。",
      "additionalProperties": false,
      "properties": {
        "event": { "type": "string", "description": "事件名,如 ACCOUNT_LOGIN。" },
        "keys": {
          "type": "array",
          "items": { "type": "string" },
          "description": "触发键字段,需与被引用变量的 groupbykeys 类型一一对应。"
        }
      }
    },

    "condition": {
      "$ref": "#/$defs/condition",
      "description": "判定条件。2.0 相比 1.x 的关键增强:支持任意嵌套的 and/or/not。1.x 策略迁移后表现为单层 and,语义完全等价。"
    },

    "action": {
      "type": "object",
      "required": ["decision", "check_type", "check_value", "ttl"],
      "additionalProperties": false,
      "description": "命中后的处置动作。",
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["accept", "review", "reject"],
          "description": "决策结果。accept 白名单 / review 待审核 / reject 阻断。"
        },
        "check_type": {
          "type": "string",
          "enum": ["IP", "USER", "DeviceID", "OrderID"],
          "description": "名单主体类型。"
        },
        "check_value": {
          "type": "string",
          "description": "取哪个事件字段作为名单主体的值,如 c_ip、uid、did。"
        },
        "ttl": {
          "type": "integer",
          "minimum": 1,
          "description": "名单有效期(秒)。到期自动失效。"
        },
        "checkpoints": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "生效检查点。为空表示全局生效。1.x 中此字段从未被使用。"
        },
        "handlers": {
          "type": "array",
          "default": [],
          "description": "2.0 新增。命中后的额外处置动作(阻断、二次验证、限流、降级、通知等),由业务系统按需实现。",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["block", "captcha", "throttle", "degrade", "notify", "webhook"] },
              "config": { "type": "object", "default": {} }
            }
          }
        }
      }
    },

    "dedup_window": {
      "type": "integer",
      "default": 300,
      "description": "同一主体同一策略的告警去重窗口(秒)。1.x 硬编码为 300 且与 ttl 无关,2.0 改为可配置。"
    },

    "explain": {
      "type": "boolean",
      "default": true,
      "description": "是否在告警中记录触发时的变量值快照。1.x 的 variable_values 字段恒为空,导致告警不可解释;2.0 默认开启。"
    }
  },

  "$defs": {
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/comparison" },
        { "$ref": "#/$defs/expression" },
        { "$ref": "#/$defs/logical" }
      ]
    },

    "logical": {
      "type": "object",
      "required": ["op", "conditions"],
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "enum": ["and", "or", "not"] },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },

    "comparison": {
      "type": "object",
      "required": ["left", "op"],
      "additionalProperties": false,
      "description": "二元比较。left 可以是事件字段、变量引用或内联计数器。",
      "properties": {
        "left": { "$ref": "#/$defs/operand" },
        "op": { "type": "string", "enum": ["==", "!=", ">", "<", ">=", "<=", "contains", "!contains", "regex", "!regex", "in", "!in"] },
        "right": { "$ref": "#/$defs/operand" }
      }
    },

    "expression": {
      "type": "object",
      "required": ["cel"],
      "additionalProperties": false,
      "description": "CEL 表达式条件。取代 1.x 基于 IK Expression 的自研 SPL。表达式在沙箱中求值,必须返回 bool。可用变量与函数见 docs/guide/cel-reference.md。",
      "properties": {
        "cel": { "type": "string", "minLength": 1 },
        "remark": { "type": "string", "default": "" }
      }
    },

    "operand": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "constant" },
            "value": {}
          }
        },
        {
          "type": "object",
          "required": ["kind", "field"],
          "additionalProperties": false,
          "description": "触发事件的字段值。",
          "properties": {
            "kind": { "const": "event_field" },
            "field": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "variable"],
          "additionalProperties": false,
          "description": "引用已定义的统计变量。",
          "properties": {
            "kind": { "const": "variable" },
            "variable": { "type": "string" },
            "keys": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "counter"],
          "additionalProperties": false,
          "description": "内联计数器 —— 在策略内现场定义一个窗口统计,等价于临时变量。",
          "properties": {
            "kind": { "const": "counter" },
            "counter": {
              "type": "object",
              "required": ["event", "window", "algorithm", "groupby"],
              "additionalProperties": false,
              "properties": {
                "event": { "type": "string" },
                "window": { "type": "integer", "minimum": 1, "description": "统计窗口(秒)。" },
                "algorithm": { "type": "string", "enum": ["count", "distinct_count", "sum"] },
                "operand": { "type": "array", "items": { "type": "string" }, "default": [] },
                "groupby": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "filter": { "type": "object", "description": "计数器自身的过滤条件,结构同 variable-model 的 filter。" }
              }
            }
          }
        }
      ]
    }
  }
}
