<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.threathunter.nebula</groupId>
  <artifactId>nebula-engine</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Nebula Engine</name>
  <description>星云 2.0 计算引擎。当前包含算子层,Flink 作业封装待实现。</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 17,不是 21。引擎的 jar 要提交给 Flink 执行,而 Flink 1.20 官方镜像最高
         只到 Java 17 —— 用 21 编出来的 class 文件(版本 65)在那上面根本加载不了,
         而且报错发生在提交作业时,不是构建时。这是运行环境施加的约束,不是偏好。
         控制面(console-api)不受此限,它是独立进程,用的是 21。 -->
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.11.3</junit.version>
    <!-- 必须与 Flink 运行时自带的 jackson-core 对齐(Flink 1.20 为 2.15.2),
         否则运行期报 NoSuchMethodError -->
    <jackson.version>2.15.2</jackson.version>
    <flink.version>1.20.5</flink.version>
  </properties>

  <dependencies>
    <!-- Flink 只被 flink/ 包依赖;算子、条件、窗口、图、规则五层都不依赖它,
         因此可以脱离 Flink 单元测试,也可以在别处复用。provided 表示由运行
         环境提供,不打进 fat jar。 -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-clients</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-base</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- 连接器必须打进作业 jar。Flink 发行版只含运行时,连接器是单独发布的
         构件,官方镜像的 /opt/flink/lib 里没有 —— 用 provided 会在提交作业时
         报 ClassNotFoundException,而本地测试(依赖都在 classpath 上)完全正常。
         官方文档也是这么建议的:连接器随作业走,不随集群走。 -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>3.3.0-1.20</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-test-utils</artifactId>
      <version>${flink.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- 算子层刻意保持零运行时依赖:它是纯计算,越少依赖越容易被 Flink 之外的
         场景复用,也越容易与参考引擎逐行对照。Jackson 只用于测试读取共享向量。 -->
    <!-- flink/ 包用它做 JSON 编解码。算子、条件、窗口、图、规则五层仍不依赖任何
         第三方库 —— 这一点由 ArchitectureTest 强制。

         打进作业 jar,不用 provided。官方 Flink 发行版里的 Jackson 被重定位到了
         org.apache.flink.shaded.jackson2.*,com.fasterxml.jackson 并不在运行时
         classpath 上。本地用完整依赖 classpath 跑时它在,提交到集群就
         NoClassDefFoundError —— 差异只在部署时暴露,本地测试一路绿灯。
         版本仍与 Flink 内部的 2.15.2 对齐,避免 shaded 与非 shaded 行为分叉。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Flink MiniCluster 在 JDK 17+ 需要开放这些模块 -->
          <argLine>
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.lang.invoke=ALL-UNNAMED
            --add-opens=java.base/java.nio=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>
      <!-- 打包成可提交给 Flink 的 fat jar。provided 范围的依赖(Flink 本体、
           Kafka connector、Jackson)由运行环境提供,不打进来。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>cn.threathunter.nebula.engine.flink.NebulaJob</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
